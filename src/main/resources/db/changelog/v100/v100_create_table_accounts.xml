<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-table-accounts " author="Zhora Khandaev">
        <createTable tableName="accounts">
            <column name="id" type="bigInt" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="email" type="varchar(55)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="passwordCrypto" type="varchar(100)">
                <constraints nullable="false"/>
            </column>

            <column name="first_name" type="varchar(55)"/>
            <column name="last_name" type="varchar(55)"/>
            <column name="middle_name" type="varchar(55)"/>

            <column name="phone" type="varchar(11)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(10)">
                <constraints nullable="false" checkConstraint="('ACTIVE', 'BLOCKED')"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>

