<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-table-transfer" author="Zhora Khandaev">
        <createTable tableName="transfers">
            <column name="id" type="bigInt" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="card_from_id" type="bigInt">
                <constraints nullable="false"
                             foreignKeyName="transfers_card_from_id_cards_id"
                             references="cards(id)"/>
            </column>

            <column name="card_to_id" type="bigInt">
                <constraints nullable="false"
                             foreignKeyName="transfers_card_to_id_cards_id"
                             references="cards(id)"/>
            </column>

        </createTable>
    </changeSet>

</databaseChangeLog>